{
  "name": "comicshelf",
  "version": "0.0.1",
  "description": "View weekly comic releases",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "back:watch": "npx tsx watch --env-file=.env src/server/server.ts",
    "front:watch": "npx vite serve",
    "build": "npx tsc",
    "run": "node --env-file=.env dist/server.js",
    "lint": "npx eslint src",
    "fmt": "npx prettier src --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakedegiovanni/comicshelf.git"
  },
  "author": "Jake Degiovanni",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jakedegiovanni/comicshelf/issues"
  },
  "homepage": "https://github.com/jakedegiovanni/comicshelf#readme",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.1.1",
    "@mui/icons-material": "^6.4.1",
    "@mui/material": "^6.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "prettier": "3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11"
  }
}
